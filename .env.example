# Configure these as Vercel Environment Variables. Do not commit real values.
GITHUB_TOKEN=replace-with-a-fine-grained-token
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Optional roles:
# SITE_USERNAME=site-owner
# SITE_PASSWORD=another-unique-password-at-least-12-characters
# STAFF_USERNAME=staff-member
# STAFF_PASSWORD=another-unique-password-at-least-12-characters
